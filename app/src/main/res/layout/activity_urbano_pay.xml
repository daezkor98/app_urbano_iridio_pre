<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brandPurple"
    android:paddingTop="48dp"
    android:paddingBottom="48dp"
    tools:context=".ui.UrbanoPayActivity">

    <!-- Logo Urbano Pay (top del chain vertical centrado) -->
    <ImageView
        android:id="@+id/img_logo_urbano_pay"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="Urbano Pay"
        android:src="@drawable/logo_urbano_pay_white"
        app:layout_constraintBottom_toTopOf="@id/lbl_titulo_entrega"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Título "GESTIONAR:\nEntrega [guía]" (afuera del card, visible en QR y PAID) -->
    <TextView
        android:id="@+id/lbl_titulo_entrega"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/gotham_rounded"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/box_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_logo_urbano_pay"
        tools:text="GESTIONAR:\nEntrega ENU433470"
        tools:visibility="visible" />

    <!-- ==================== CARD BLANCO CENTRAL ==================== -->
    <!-- Contiene los 3 grupos (inicial / qr / pagado). Su tamaño se adapta al contenido visible.
         clipChildren=false permite que el pill "ESCANEA PARA PAGAR" flote sobre el borde inferior. -->
    <LinearLayout
        android:id="@+id/box_card"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_urbano_pay_pill_white"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="20dp"
        app:layout_constraintBottom_toTopOf="@id/btn_efectivo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lbl_titulo_entrega">

        <!-- ============ ESTADO INICIAL ============ -->
        <LinearLayout
            android:id="@+id/box_estado_inicial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_marginBottom="15dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lbl_guia_inicial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gotham_rounded"
                android:textColor="@color/brandPurple"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="ENU433470" />
        </LinearLayout>

        <!-- ============ ESTADO QR ============ -->
        <LinearLayout
            android:id="@+id/box_estado_qr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/qr_code_image"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginVertical="4dp"
                android:adjustViewBounds="true"
                android:contentDescription="QR"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/lbl_monto_qr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/gotham_rounded"
                android:gravity="center"
                android:textColor="@color/brandPurple"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="S/45.90" />

            <TextView
                android:id="@+id/lbl_rq_id_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/comfortaa"
                android:gravity="center"
                android:textColor="@color/colorUrbanoGrey"
                android:textSize="11sp"
                tools:text="ID Operación 3141" />

            <TextView
                android:id="@+id/lbl_progreso_pago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/comfortaa"
                android:gravity="center"
                android:textColor="@color/colorUrbanoGrey"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/comfortaa"
                android:gravity="center"
                android:text="Puedes pagar con tus billeteras electrónicas de:"
                android:textColor="@color/colorUrbanoGrey"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="3dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Yape"
                    android:scaleType="fitCenter"
                    android:src="@drawable/yape" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="3dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Plin"
                    android:scaleType="fitCenter"
                    android:src="@drawable/plin" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="3dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="BCP"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bcp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="3dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="BBVA"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bbva" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="3dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Interbank"
                    android:scaleType="fitCenter"
                    android:src="@drawable/itbk" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="3dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Scotiabank"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sct" />
            </LinearLayout>

        </LinearLayout>

        <!-- ============ ESTADO PAGADO ============ -->
        <LinearLayout
            android:id="@+id/box_estado_pagado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="Pago realizado"
                android:src="@drawable/ic_check_circle_urbano_pay" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/gotham_rounded_bold"
                android:text="¡PAGADO!"
                android:textColor="@color/brandPurple"
                android:textSize="22sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="@color/gris_3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/comfortaa"
                    android:text="Guía:"
                    android:textColor="@color/colorUrbanoGrey"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/lbl_pagado_guia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/comfortaa"
                    android:gravity="end"
                    android:textColor="@color/brandPurple"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/comfortaa"
                    android:text="Monto:"
                    android:textColor="@color/colorUrbanoGrey"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/lbl_pagado_monto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/comfortaa"
                    android:gravity="end"
                    android:textColor="@color/brandPurple"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/comfortaa"
                    android:text="Documento:"
                    android:textColor="@color/colorUrbanoGrey"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/lbl_pagado_doc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/comfortaa"
                    android:gravity="end"
                    android:textColor="@color/brandPurple"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/comfortaa"
                    android:text="Nombre:"
                    android:textColor="@color/colorUrbanoGrey"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/lbl_pagado_nombre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/comfortaa"
                    android:gravity="end"
                    android:textColor="@color/brandPurple"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_continuar_pago"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_btn_filled_secondary"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/gotham_rounded"
                android:gravity="center"
                android:text="CONTINUAR"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botón GENERAR QR — flota centrado sobre el borde inferior del card (estado inicial). -->
    <TextView
        android:id="@+id/btn_generar_qr"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_urbano_pay_pill_pink"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:fontFamily="@font/gotham_rounded"
        android:gravity="center"
        android:paddingHorizontal="40dp"
        android:paddingVertical="14dp"
        android:text="GENERAR QR"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/box_card"
        app:layout_constraintEnd_toEndOf="@id/box_card"
        app:layout_constraintStart_toStartOf="@id/box_card"
        app:layout_constraintTop_toBottomOf="@id/box_card" />

    <!-- Pill "ESCANEA PARA PAGAR" — flota centrado sobre el borde inferior del card.
         top y bottom ambos apuntan al bottom del card, se centra en esa Y con bias 0.5.
         Solo visible en estado QR (se toggle desde UrbanoPayActivity). -->
    <TextView
        android:id="@+id/lbl_escanea_pagar_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_urbano_pay_pill_pink"
        android:elevation="6dp"
        android:fontFamily="@font/gotham_rounded"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:paddingVertical="12dp"
        android:text="ESCANEA PARA PAGAR"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/box_card"
        app:layout_constraintEnd_toEndOf="@id/box_card"
        app:layout_constraintStart_toStartOf="@id/box_card"
        app:layout_constraintTop_toBottomOf="@id/box_card"
        tools:visibility="visible" />

    <!-- Botón "PAGO EN EFECTIVO" (outline blanco, cierre del chain vertical centrado).
         Margen extra arriba para dejar espacio al pill "ESCANEA PARA PAGAR" que sobresale
         del card en estado QR. -->
    <TextView
        android:id="@+id/btn_efectivo"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_btn_outline_white"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/gotham_rounded"
        android:gravity="center"
        android:paddingHorizontal="36dp"
        android:text="PAGO EN EFECTIVO"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/box_watermark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/box_card" />

    <!-- Watermark "Portal de pagos Urbano" en el fondo (siempre visible, sutil) -->
    <LinearLayout
        android:id="@+id/box_watermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:alpha="0.7"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/comfortaa"
            android:text="Portal de pagos de"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <ImageView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:adjustViewBounds="true"
            android:contentDescription="Urbano"
            android:src="@drawable/logo_urbano_white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
